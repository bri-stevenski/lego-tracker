{
  "version": 1,
  "name": "anti-kragle",
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.harness/**",
      "**/output/**"
    ]
  },
  "arch": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.harness/**",
      "**/output/**"
    ]
  },
  "layers": [
    {
      "name": "types",
      "pattern": "packages/core/src/types/*.ts",
      "allowedDependencies": []
    },
    {
      "name": "services",
      "pattern": "{packages/core/src/services/*.ts,apps/web/src/services/*.ts}",
      "allowedDependencies": [
        "types"
      ]
    },
    {
      "name": "domain",
      "pattern": "packages/core/src/domain/*.ts",
      "allowedDependencies": [
        "types",
        "services"
      ],
      "description": "Domain depends on services for external catalog orchestration and caching."
    },
    {
      "name": "app",
      "pattern": "apps/web/src/app/*.{ts,tsx}",
      "allowedDependencies": [
        "types",
        "domain",
        "services"
      ]
    }
  ],
  "entryPoints": [
    "./apps/web/src/app/index.tsx",
    "./packages/core/src/index.ts"
  ],
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "template": {
    "level": "basic",
    "version": 1
  },
  "telemetry": {
    "enabled": true
  },
  "adoption": {
    "enabled": true
  }
}
